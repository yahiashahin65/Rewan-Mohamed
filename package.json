{
  "name": "rewan-mohamed-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arabic-first bilingual portfolio for Rewan Mohamed, with static SEO landing pages, certificate gallery and appointment inquiries.",
  "scripts": {
    "build": "node scripts/build-static.mjs && node scripts/generate-seo.mjs",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "preview": "node scripts/dev-server.mjs",
    "build:react": "vite build && node scripts/generate-seo.mjs",
    "dev:react": "vite --host 0.0.0.0",
    "check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
